---
import leadership from '../data/chapter-two-leadership.json';

const periods = leadership.periods;
---

<section id="liderazgo-espacial" class="chapter-two" data-leadership-chapter>
  <div class="chapter-two-opening reveal">
    <p class="eyebrow">Capítulo 2</p>
    <h2>¿Quién dominaba el espacio?</h2>
    <p>No se trata solo de contar lanzamientos. El liderazgo espacial revela quién controlaba realmente el acceso a la órbita en cada época.</p>
  </div>

  <div class="leadership-map-scene sticky-story-block">
    <div class="leadership-steps" aria-label="Etapas históricas del mapa">
      <div class="leadership-block-intro reveal">
        <p class="eyebrow">Mapa / contexto geográfico</p>
        <h3>El poder espacial también tiene geografía</h3>
        <p>La intensidad del mapa mantiene una escala única para todos los periodos. Así, los cambios de color reflejan cambios reales de actividad, no escalas recalculadas.</p>
      </div>
      {periods.map((period) => (
        <article class="leadership-step" data-period={period.id}>
          <span>{period.id}</span>
          <h4>{period.name}</h4>
          <p>{period.text}</p>
        </article>
      ))}
    </div>

    <div class="sticky-visual-column">
      <div class="leadership-map-stage panel-glass reveal sticky-visual">
        <svg class="leadership-map" viewBox="0 0 1280 690" role="img" aria-label="Mapa mundial de actividad espacial por periodo histórico"></svg>
        <div class="map-scale-legend" aria-label="Escala global fija de lanzamientos por periodo">
          <span>Actividad por país</span>
          <p>Escala fija en todos los periodos</p>
          <div class="map-legend-rows">
            <small><i style="--legend-color: rgba(174,187,208,0.09)"></i>0</small>
            <small><i style="--legend-color: #d7f3ff"></i>1-9</small>
            <small><i style="--legend-color: #8fd3ff"></i>10-49</small>
            <small><i style="--legend-color: #3f9dff"></i>50-199</small>
            <small><i style="--legend-color: #1764d8"></i>200-499</small>
            <small><i style="--legend-color: #062b8f"></i>500+</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="leadership-turn reveal">
    <p>El mapa muestra dónde se concentra la actividad. Pero el acceso al espacio lo controlan actores concretos.</p>
  </div>

  <div class="ranking-stage reveal">
    <div class="ranking-head">
      <div>
        <p class="eyebrow">Ranking / historia principal</p>
        <h3>Los proveedores que abrieron la puerta a la órbita</h3>
      </div>
      <p>Las barras se reorganizan al avanzar por las etapas. Solo aparecen actores con actividad real en cada periodo.</p>
    </div>

    <div class="ranking-layout sticky-story-block">
      <div class="ranking-periods" aria-label="Etapas históricas del ranking">
        <div class="ranking-block-intro">
          <p class="eyebrow">Etapas</p>
          <p>Al avanzar, la escena se mantiene: solo cambian posiciones, valores y protagonistas.</p>
        </div>
        {periods.map((period) => (
          <article class="ranking-step" data-period={period.id}>
            <span>{period.id}</span>
            <strong>{period.name}</strong>
            <p>{period.annotation}</p>
          </article>
        ))}
      </div>
      <div class="sticky-visual-column">
        <div class="ranking-canvas-wrap sticky-visual">
          <svg class="provider-ranking" viewBox="0 0 1160 760" role="img" aria-label="Ranking de proveedores de lanzamiento por periodo"></svg>
        </div>
      </div>
    </div>
  </div>

  <div class="chapter-two-close reveal">
    <p>El liderazgo espacial dejó de estar concentrado únicamente en Estados.</p>
    <p>Nuevos países y empresas privadas transformaron el equilibrio histórico.</p>
  </div>
</section>

<script>
  import * as d3 from 'd3';
  import { feature } from 'topojson-client';
  import world from 'world-atlas/countries-110m.json';
  import leadership from '../data/chapter-two-leadership.json';

  const chapter = document.querySelector('[data-leadership-chapter]');

  if (chapter) {
    const periods = leadership.periods;
    const periodById = new Map(periods.map((period) => [period.id, period]));
    const providerMax = leadership.globalMax.provider;
    const mapSvg = d3.select(chapter.querySelector('.leadership-map'));
    const rankingSvg = d3.select(chapter.querySelector('.provider-ranking'));

    const width = 1280;
    const height = 690;
    const projection = d3.geoNaturalEarth1().fitExtent([[42, 34], [width - 42, height - 52]], feature(world, world.objects.countries));
    const path = d3.geoPath(projection);
    const countries = feature(world, world.objects.countries).features;
    const color = d3.scaleThreshold()
      .domain([10, 50, 200, 500])
      .range(['#d7f3ff', '#8fd3ff', '#3f9dff', '#1764d8', '#062b8f']);

    mapSvg.append('rect').attr('width', width).attr('height', height).attr('rx', 34).attr('fill', 'rgba(5,8,22,0.58)');
    mapSvg.append('g')
      .attr('class', 'graticule')
      .append('path')
      .datum(d3.geoGraticule10())
      .attr('d', path)
      .attr('fill', 'none')
      .attr('stroke', 'rgba(174,187,208,0.12)')
      .attr('stroke-width', 0.8);

    const mapLayer = mapSvg.append('g').attr('class', 'countries');
    mapLayer.selectAll('path')
      .data(countries)
      .join('path')
      .attr('d', path)
      .attr('fill', 'rgba(174,187,208,0.10)')
      .attr('stroke', 'rgba(237,244,255,0.22)')
      .attr('stroke-width', 0.45)
      .attr('data-country', (d) => d.properties.name);

    const updateMap = (periodId) => {
      const period = periodById.get(periodId) || periods[0];
      const values = new Map(period.countries.map((item) => [item.name, item.value]));

      mapLayer.selectAll('path')
        .transition()
        .duration(1200)
        .ease(d3.easeCubicInOut)
        .attr('fill', (d) => {
          const value = values.get(d.properties.name) || 0;
          return value ? color(value) : 'rgba(174,187,208,0.09)';
        })
        .attr('stroke', (d) => values.get(d.properties.name) ? 'rgba(237,244,255,0.56)' : 'rgba(237,244,255,0.16)')
        .attr('stroke-width', (d) => values.get(d.properties.name) ? 0.85 : 0.38);
    };

    const ranking = {
      width: 1160,
      height: 760,
      margin: { top: 42, right: 170, bottom: 52, left: 270 },
    };
    const x = d3.scaleLinear().domain([0, providerMax]).range([0, ranking.width - ranking.margin.left - ranking.margin.right]);
    const rankingRoot = rankingSvg.append('g').attr('transform', `translate(${ranking.margin.left},${ranking.margin.top})`);
    rankingSvg.append('line')
      .attr('x1', ranking.margin.left)
      .attr('x2', ranking.width - ranking.margin.right)
      .attr('y1', ranking.height - ranking.margin.bottom)
      .attr('y2', ranking.height - ranking.margin.bottom)
      .attr('stroke', 'rgba(174,187,208,.22)');

    const providerColor = d3.scaleOrdinal()
      .domain(['SpaceX', 'CASC', 'Soviet/Russian Strategic Rocket Forces', 'UNKS', 'NASA', 'Arianespace', 'Roscosmos', 'United Launch Alliance', 'ISRO'])
      .range(['#8f7aa8', '#a49363', '#9b6b73', '#9b6b73', '#6f86a3', '#6f9a97', '#9b6b73', '#6f86a3', '#7f9871']);

    const updateRanking = (periodId) => {
      const period = periodById.get(periodId) || periods[0];
      const data = period.providers.filter((item) => item.value > 0).slice(0, 10);
      const rowHeight = 58;
      const y = d3.scaleBand().domain(data.map((item) => item.name)).range([0, data.length * rowHeight]).padding(0.24);

      const rows = rankingRoot.selectAll('g.provider-row')
        .data(data, (d) => d.name)
        .join(
          (enter) => {
            const group = enter.append('g').attr('class', 'provider-row').attr('transform', (d) => `translate(0,${y(d.name) ?? 0})`).attr('opacity', 0);
            group.append('text').attr('class', 'provider-name').attr('x', -18).attr('y', y.bandwidth() / 2 + 6).attr('text-anchor', 'end').text((d) => d.name);
            group.append('rect').attr('height', y.bandwidth()).attr('rx', 10).attr('width', 0).attr('fill', (d) => providerColor(d.name) || 'rgba(174,187,208,0.46)').attr('opacity', 0.72);
            group.append('text').attr('class', 'provider-value').attr('x', 12).attr('y', y.bandwidth() / 2 + 6).text('0');
            return group.call((enter) => enter.transition().duration(800).attr('opacity', 1));
          },
          (update) => update,
          (exit) => exit.call((exit) => exit.transition().duration(500).attr('opacity', 0).attr('transform', `translate(0,${data.length * rowHeight + 20})`).remove())
        );

      rows.transition().duration(1250).ease(d3.easeCubicInOut).attr('transform', (d) => `translate(0,${y(d.name) ?? 0})`).attr('opacity', 1);
      rows.select('rect').transition().duration(1250).ease(d3.easeCubicInOut).attr('width', (d) => x(d.value)).attr('height', y.bandwidth()).attr('fill', (d) => providerColor(d.name) || 'rgba(174,187,208,0.46)').attr('opacity', 0.72);
      rows.select('text.provider-name').transition().duration(1250).attr('y', y.bandwidth() / 2 + 6);
      rows.select('text.provider-value')
        .transition()
        .duration(1250)
        .ease(d3.easeCubicInOut)
        .attr('x', (d) => x(d.value) + 14)
        .attr('y', y.bandwidth() / 2 + 6)
        .tween('text', function(d) {
          const current = Number(this.textContent || 0);
          const interpolate = d3.interpolateNumber(current, d.value);
          return function(t) {
            this.textContent = Math.round(interpolate(t)).toLocaleString('es-ES');
          };
        });
    };

    const activateStep = (step, updater) => {
      const periodId = step.getAttribute('data-period');
      if (!periodId) return;
      step.parentElement?.querySelectorAll('[data-period]').forEach((item) => item.classList.remove('is-active'));
      step.classList.add('is-active');
      updater(periodId);
    };

    const bindScrollSteps = (selector, updater) => {
      const steps = Array.from(chapter.querySelectorAll(selector));
      let activePeriodId = '';
      let ticking = false;

      const updateActiveStep = () => {
        const targetY = window.innerHeight * 0.5;
        let closestStep = null;
        let closestDistance = Number.POSITIVE_INFINITY;

        steps.forEach((step) => {
          const rect = step.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > window.innerHeight) return;

          const stepCenter = rect.top + rect.height * 0.5;
          const distance = Math.abs(stepCenter - targetY);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestStep = step;
          }
        });

        const periodId = closestStep?.getAttribute('data-period');
        if (!closestStep || !periodId || periodId === activePeriodId) return;

        activePeriodId = periodId;
        activateStep(closestStep, updater);
      };

      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          updateActiveStep();
        });
      };

      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate);
      if (steps[0]) activateStep(steps[0], updater);
      updateActiveStep();
    };

    updateMap(periods[0].id);
    updateRanking(periods[0].id);
    bindScrollSteps('.leadership-step', updateMap);
    bindScrollSteps('.ranking-step', updateRanking);
  }
</script>
