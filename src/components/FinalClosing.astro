---
import earthImage from '../assets/images/tierra.png';
---

<section class="final-closing" aria-label="Cierre">
  <div class="final-closing-earth">
    <img src={earthImage} alt="" aria-hidden="true" />
  </div>

  <div class="final-closing-text">
    <p class="final-closing-title">De Sputnik a Starlink</p>
    <p class="final-closing-sub">De la carrera espacial a la economía orbital.</p>
    <p class="final-closing-verse">11.627 registros después,<br />el espacio ya no es una frontera.<br />Es parte de nuestro mundo.</p>
  </div>

  <p class="final-closing-end">FIN</p>
</section>

<style>
  .final-closing {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
  }

  .final-closing-earth {
    position: absolute;
    width: clamp(8rem, 18vw, 18rem);
    aspect-ratio: 1;
    border-radius: 999px;
    opacity: 0.5;
    animation: earthSpin 60s linear infinite;
    filter: saturate(0.7) brightness(0.8) contrast(1.2);
    pointer-events: none;
  }

  .final-closing-earth img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 999px;
  }

  @keyframes earthSpin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .final-closing-earth {
      animation: none;
    }
  }

  .final-closing-text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.8rem;
    max-width: 58rem;
    padding: 2rem;
  }

  .final-closing-title {
    color: #fff;
    font-family: 'Space Grotesk', Inter, system-ui, sans-serif;
    font-size: clamp(2.8rem, 5.6vw, 6.5rem);
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 0.88;
    margin: 0;
  }

  .final-closing-sub {
    color: var(--accent-cyan);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: clamp(0.85rem, 1.1vw, 1.15rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0;
  }

  .final-closing-verse {
    color: var(--text-secondary);
    font-size: clamp(1.1rem, 1.6vw, 1.65rem);
    line-height: 1.7;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .final-closing-end {
    position: absolute;
    bottom: clamp(3rem, 6vh, 6rem);
    color: var(--text-muted);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: clamp(0.7rem, 0.85vw, 0.9rem);
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    margin: 0;
    opacity: 0;
    animation: fadeEnd 1.5s ease 5s forwards;
  }

  @keyframes fadeEnd {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .final-closing-end {
      opacity: 1;
      animation: none;
    }
  }
</style>
